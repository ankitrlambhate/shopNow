# Copy to config.env and edit:   cp config.env.example config.env
# config.env is git-ignored (it holds passwords). Used by ./run.sh.

# ---- AWS ----------------------------------------------------------------------------------------
AWS_REGION=ap-south-1
ENVIRONMENT=dev                      # cluster will be named shopnow-<ENVIRONMENT>-eks

# An EC2 key pair that ALREADY exists in AWS_REGION (EC2 console > Key Pairs > Create), and its .pem file
SSH_KEY_NAME=my-key-pair
SSH_KEY_FILE=$HOME/.ssh/my-key-pair.pem

# Who may SSH to the tools host and reach the EKS API. Leave empty to use your current public IP (/32).
ADMIN_CIDR=

# ---- Application ---------------------------------------------------------------------------------
APP_PATH_PREFIX=shopnow              # apps are served at /<prefix> and /<prefix>-admin (replaces "aryan")
NAMESPACE=shopnow-demo
ECR_NAMESPACE=shopnow                # ECR repos: <ECR_NAMESPACE>/frontend, /backend, /admin

# ---- Secrets (letters and digits ONLY: no spaces, $, quotes or symbols - this file is read as a shell script) ----
MONGO_APP_PASSWORD=ChangeMeApp123
MONGO_ROOT_PASSWORD=ChangeMeRoot123
GRAFANA_ADMIN_PASSWORD=ChangeMeGrafana123

# ---- Monitoring (optional) ------------------------------------------------------------------------
GRAFANA_SERVICE_TYPE=ClusterIP       # ClusterIP = free, use kubectl port-forward | LoadBalancer = public URL, ~$0.60/day extra
JENKINS_HOST=                        # Hero Vired Jenkins hostname WITHOUT https:// (enables Jenkins metrics + alert webhook)
