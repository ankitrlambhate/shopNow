// Terraform provisioning pipeline (Sprint 2).
// Job type: Pipeline from SCM, Script Path = jenkins/Jenkinsfile.terraform
// Job name suggestion: infra-terraform
pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 60, unit: 'MINUTES')
  }

  parameters {
    choice(name: 'ACTION', choices: ['plan', 'apply', 'destroy'], description: 'Terraform action')
    string(name: 'AWS_REGION',       defaultValue: 'ap-south-1',   description: 'AWS region')
    string(name: 'ENVIRONMENT',      defaultValue: 'dev',          description: 'Environment (dev/staging/prod)')
    string(name: 'TF_STATE_BUCKET',  defaultValue: '',             description: 'S3 bucket for state (from scripts/bootstrap-tf-backend.sh)')
    string(name: 'TF_LOCK_TABLE',    defaultValue: 'shopnow-tf-lock', description: 'DynamoDB lock table')
    string(name: 'SSH_KEY_NAME',     defaultValue: '',             description: 'Existing EC2 key pair name')
    string(name: 'ADMIN_CIDR',       defaultValue: '0.0.0.0/0',    description: 'CIDR allowed to SSH / reach the EKS API (tighten this!)')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: 'aws-credentials', description: 'Jenkins AWS credentials ID')
    booleanParam(name: 'AUTO_APPROVE', defaultValue: false,        description: 'Skip the manual approval step (apply/destroy)')
    booleanParam(name: 'TRIGGER_ANSIBLE', defaultValue: true,      description: 'Run the Ansible job after a successful apply')
  }

  environment {
    TF_IN_AUTOMATION = 'true'
    TF_INPUT         = '0'
    TF_DIR           = 'terraform'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Validate Inputs') {
      steps {
        script {
          if (!params.TF_STATE_BUCKET?.trim()) { error 'TF_STATE_BUCKET is required' }
          if (!params.SSH_KEY_NAME?.trim())    { error 'SSH_KEY_NAME is required' }
        }
      }
    }

    stage('Terraform Init & Validate') {
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          dir(env.TF_DIR) {
            sh '''
              terraform fmt -check -recursive
              terraform init -reconfigure \
                -backend-config="bucket=${TF_STATE_BUCKET}" \
                -backend-config="dynamodb_table=${TF_LOCK_TABLE}" \
                -backend-config="region=${AWS_REGION}" \
                -backend-config="key=shopnow/${ENVIRONMENT}/terraform.tfstate"
              terraform validate
            '''
          }
        }
      }
    }

    stage('Terraform Plan') {
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          dir(env.TF_DIR) {
            script {
              def destroyFlag = (params.ACTION == 'destroy') ? '-destroy' : ''
              sh """
                terraform plan ${destroyFlag} -out=tfplan \
                  -var="aws_region=${params.AWS_REGION}" \
                  -var="environment=${params.ENVIRONMENT}" \
                  -var="ssh_key_name=${params.SSH_KEY_NAME}" \
                  -var="admin_cidr=${params.ADMIN_CIDR}"
                terraform show -no-color tfplan > tfplan.txt
              """
            }
          }
        }
        archiveArtifacts artifacts: 'terraform/tfplan.txt', allowEmptyArchive: true
      }
    }

    stage('Approval') {
      when {
        allOf {
          expression { params.ACTION != 'plan' }
          expression { !params.AUTO_APPROVE }
        }
      }
      steps {
        timeout(time: 30, unit: 'MINUTES') {
          input message: "Review tfplan.txt (archived). Proceed with terraform ${params.ACTION} on ${params.ENVIRONMENT}?", ok: 'Proceed'
        }
      }
    }

    stage('Terraform Apply / Destroy') {
      when { expression { params.ACTION != 'plan' } }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          dir(env.TF_DIR) {
            sh 'terraform apply -auto-approve tfplan'
          }
        }
      }
    }

    stage('Export Outputs') {
      when { expression { params.ACTION == 'apply' } }
      steps {
        withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
          dir(env.TF_DIR) {
            sh 'terraform output -json > ../tf-outputs.json'
          }
        }
        archiveArtifacts artifacts: 'tf-outputs.json'
        script {
          def out = readJSON(file: 'tf-outputs.json')
          env.EKS_CLUSTER_NAME = out.cluster_name.value
          env.BASTION_IP       = out.bastion_public_ip.value
          echo "Cluster: ${env.EKS_CLUSTER_NAME} | Bastion: ${env.BASTION_IP}"
        }
      }
    }

    stage('Trigger Ansible Job') {
      when {
        allOf {
          expression { params.ACTION == 'apply' }
          expression { params.TRIGGER_ANSIBLE }
        }
      }
      steps {
        // Wait ~60s so the new EC2 instance finishes booting and SSH is reachable
        sleep time: 60, unit: 'SECONDS'
        build job: 'config-ansible', wait: true, parameters: [
          string(name: 'AWS_REGION', value: params.AWS_REGION),
          string(name: 'EKS_CLUSTER_NAME', value: env.EKS_CLUSTER_NAME),
          string(name: 'AWS_CREDENTIALS_ID', value: params.AWS_CREDENTIALS_ID)
        ]
      }
    }
  }

  post {
    failure { echo 'Terraform pipeline failed. Check the console log; state is locked in DynamoDB only while running.' }
    always  { cleanWs(deleteDirs: true, notFailBuild: true) }
  }
}
