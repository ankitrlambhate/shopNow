// shopNow application CI/CD (Sprint 4): test -> build 3 images -> push to ECR -> deploy to EKS -> smoke test.
// Jenkins job name suggestion: app-cicd   (type: Pipeline script from SCM, Script Path: jenkins/Jenkinsfile.app-cicd)
//
// Jenkins credentials needed:
//   ankitlambhate-aws-credentials AWS Credentials (skip by ticking USE_INSTANCE_ROLE when the agent has an IAM role)
//   shopnow-mongo-app-password    Secret text, alphanumeric (password of the MongoDB application user)
//   shopnow-mongo-root-password   Secret text, alphanumeric (password of the MongoDB root user)
// Agent needs: docker, aws, kubectl, helm, python3 (see jenkins/install-jenkins-ec2.sh --tools-only)

pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 60, unit: 'MINUTES')
  }

  triggers {
    // Fallback to the GitHub webhook: poll SCM every 5 minutes
    pollSCM('H/5 * * * *')
  }

  parameters {
    string(name: 'AWS_REGION',         defaultValue: 'ap-south-1',        description: 'AWS region')
    string(name: 'EKS_CLUSTER_NAME',   defaultValue: 'shopnow-dev-eks',   description: 'EKS cluster name (Terraform output cluster_name)')
    string(name: 'ECR_NAMESPACE',      defaultValue: 'shopnow',           description: 'ECR repository prefix: <prefix>/frontend, /backend, /admin (Terraform var ecr_namespace)')
    string(name: 'APP_PATH_PREFIX',    defaultValue: 'shopnow',           description: 'URL prefix baked into the React apps: /<prefix> and /<prefix>-admin (the "USER_NAME" build arg)')
    string(name: 'NAMESPACE',          defaultValue: 'shopnow-demo',      description: 'Kubernetes namespace')
    string(name: 'AWS_CREDENTIALS_ID', defaultValue: 'ankitlambhate-aws-credentials', description: 'Jenkins AWS credentials ID')
    booleanParam(name: 'USE_INSTANCE_ROLE', defaultValue: false,          description: 'Use the agent IAM role instead of Jenkins AWS credentials')
    string(name: 'MONGO_APP_PW_ID',    defaultValue: 'shopnow-mongo-app-password',  description: 'Jenkins secret-text ID for the MongoDB app user password')
    string(name: 'MONGO_ROOT_PW_ID',   defaultValue: 'shopnow-mongo-root-password', description: 'Jenkins secret-text ID for the MongoDB root password')
    booleanParam(name: 'DEPLOY',       defaultValue: true,                description: 'Deploy to EKS after pushing the images')
    booleanParam(name: 'RUN_WRITE_TESTS', defaultValue: true,             description: 'Smoke test also creates and cancels one test order (decrements one product stock)')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
        script {
          env.GIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
          env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_SHORT}"
          echo "Image tag: ${env.IMAGE_TAG}"
        }
      }
    }

    stage('Backend Unit Tests') {
      steps {
        // Throw-away Node container, running as the Jenkins user so the workspace stays deletable
        sh '''
          docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp -e npm_config_cache=/tmp/.npm \
            -v "$WORKSPACE/backend":/app -w /app node:20-alpine \
            sh -c "npm ci --no-audit --no-fund && npm test"
        '''
      }
    }

    stage('Resolve ECR Registry') {
      steps {
        script {
          withAws {
            env.ACCOUNT_ID   = sh(script: 'aws sts get-caller-identity --query Account --output text', returnStdout: true).trim()
            env.ECR_REGISTRY = "${env.ACCOUNT_ID}.dkr.ecr.${params.AWS_REGION}.amazonaws.com"
          }
          echo "Registry: ${env.ECR_REGISTRY}"
        }
      }
    }

    stage('Build Images') {
      parallel {
        stage('backend') {
          steps {
            sh 'docker build -t $ECR_REGISTRY/$ECR_NAMESPACE/backend:$IMAGE_TAG backend'
          }
        }
        stage('frontend') {
          steps {
            sh 'docker build --build-arg USER_NAME=$APP_PATH_PREFIX -t $ECR_REGISTRY/$ECR_NAMESPACE/frontend:$IMAGE_TAG frontend'
          }
        }
        stage('admin') {
          steps {
            sh 'docker build --build-arg USER_NAME=$APP_PATH_PREFIX -t $ECR_REGISTRY/$ECR_NAMESPACE/admin:$IMAGE_TAG admin'
          }
        }
      }
    }

    stage('Image Scan (optional)') {
      steps {
        // Runs only when trivy is installed on the agent; reports HIGH/CRITICAL findings without failing the build
        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
          sh '''
            if command -v trivy >/dev/null 2>&1; then
              for svc in backend frontend admin; do
                trivy image --severity HIGH,CRITICAL --exit-code 0 --no-progress $ECR_REGISTRY/$ECR_NAMESPACE/$svc:$IMAGE_TAG
              done
            else
              echo "trivy not installed on this agent: skipping scan"
            fi
          '''
        }
      }
    }

    stage('Push to ECR') {
      steps {
        script {
          withAws {
            sh '''
              aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY
              for svc in backend frontend admin; do
                docker push $ECR_REGISTRY/$ECR_NAMESPACE/$svc:$IMAGE_TAG
              done
            '''
          }
        }
      }
    }

    stage('Cluster Add-ons') {
      when { expression { params.DEPLOY } }
      steps {
        script {
          withAws {
            sh '''
              aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER_NAME
              chmod +x scripts/*.sh
              ./scripts/install-cluster-addons.sh
            '''
          }
        }
      }
    }

    stage('Render & Validate Manifests') {
      steps {
        sh '''
          chmod +x scripts/*.sh
          ./scripts/render-manifests.sh rendered
          python3 - <<'PY'
import glob, sys
try:
    import yaml
except ImportError:
    print("pyyaml not installed: skipping YAML syntax check"); sys.exit(0)
files = sorted(glob.glob("rendered/**/*.yaml", recursive=True))
for f in files:
    list(yaml.safe_load_all(open(f)))
print("Parsed %d manifests OK" % len(files))
PY
          # Only the five template variables must be gone (the Mongo init script keeps its own runtime shell variables)
          if grep -rnE '[$][{](NAMESPACE|ECR_REGISTRY|ECR_NAMESPACE|IMAGE_TAG|APP_PATH_PREFIX)[}]' rendered/; then
            echo "Unrendered template variables found"; exit 1
          fi
        '''
      }
    }

    stage('Deploy to EKS') {
      when { expression { params.DEPLOY } }
      steps {
        script {
          env.DEPLOY_STARTED = 'true'
          withAws {
            withCredentials([
              string(credentialsId: params.MONGO_APP_PW_ID,  variable: 'MONGO_APP_PASSWORD'),
              string(credentialsId: params.MONGO_ROOT_PW_ID, variable: 'MONGO_ROOT_PASSWORD')
            ]) {
              sh '''
                set -e
                aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER_NAME

                kubectl apply -f rendered/namespace/
                ./scripts/create-secrets.sh

                kubectl apply -f rendered/database/
                kubectl -n $NAMESPACE rollout status statefulset/mongo --timeout=420s

                kubectl apply -f rendered/backend/
                kubectl -n $NAMESPACE rollout status deployment/backend --timeout=300s

                kubectl apply -f rendered/frontend/ -f rendered/admin/
                kubectl -n $NAMESPACE rollout status deployment/frontend --timeout=300s
                kubectl -n $NAMESPACE rollout status deployment/admin --timeout=300s

                kubectl apply -f rendered/ingress/
                kubectl -n $NAMESPACE get deploy,sts,svc,hpa,ing
              '''
            }
          }
        }
      }
    }

    stage('Smoke Test') {
      when { expression { params.DEPLOY } }
      steps {
        script {
          withAws {
            sh '''
              aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER_NAME
              WRITE_TESTS=${RUN_WRITE_TESTS} ./scripts/smoke-test.sh
            '''
          }
        }
      }
    }
  }

  post {
    success {
      echo "shopNow ${env.IMAGE_TAG} deployed to ${params.EKS_CLUSTER_NAME} (namespace ${params.NAMESPACE})"
    }
    failure {
      script {
        if (env.DEPLOY_STARTED == 'true') {
          echo 'Deployment failed: rolling the application deployments back to their previous revision.'
          try {
            withAws {
              sh '''
                aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER_NAME || true
                for d in backend frontend admin; do
                  kubectl -n $NAMESPACE rollout undo deployment/$d || true
                done
              '''
            }
          } catch (err) {
            echo "Rollback skipped: ${err}"
          }
        }
      }
      // Notifications: enable after configuring SMTP (Email Extension) or the Slack plugin on Jenkins.
      // mail to: 'team@example.com', subject: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER}", body: "${env.BUILD_URL}"
      // slackSend(color: 'danger', message: "FAILED: ${env.JOB_NAME} #${env.BUILD_NUMBER} (<${env.BUILD_URL}|open>)")
    }
    always {
      sh 'docker image prune -f || true'
      cleanWs(deleteDirs: true, notFailBuild: true)
    }
  }
}

// ---- helpers -------------------------------------------------------------------------------------------------

def awsEnv() {
  return ["AWS_REGION=${params.AWS_REGION}", "AWS_DEFAULT_REGION=${params.AWS_REGION}"]
}

// Runs the closure with AWS credentials from Jenkins, or with the agent's IAM role when USE_INSTANCE_ROLE is set.
def withAws(Closure body) {
  if (params.USE_INSTANCE_ROLE) {
    withEnv(awsEnv()) { body() }
  } else {
    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: params.AWS_CREDENTIALS_ID]]) {
      withEnv(awsEnv()) { body() }
    }
  }
}
